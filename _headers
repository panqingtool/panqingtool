# Cloudflare Pages 静态响应头
# CSP：默认只允许本站；script/style 允许 jsdelivr/unpkg/esm.sh 与内联（用于 AppTools 单文件即时渲染）
# img 允许 data:/blob: 和任意 https（用户上传图、维基百科头像等）
# connect 允许的联网接口（前端 fetch 走这些域）；worker-src 'self' 用于 SW 重新注册

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://esm.sh blob:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com https://esm.sh https://api.open-meteo.com https://api.frankfurter.app https://open.er-api.com https://api.dictionaryapi.dev https://ipwho.is https://tcc.taobao.com https://*.wikipedia.org; worker-src 'self' blob:; manifest-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), magnetometer=(self), accelerometer=(self), gyroscope=(self), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# /functions/* 的安全头（MIME 嗅探等由 functions/_middleware.js 处理）
/functions/*
  X-Content-Type-Options: nosniff
